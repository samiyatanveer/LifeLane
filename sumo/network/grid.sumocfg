<?xml version="1.0" encoding="UTF-8"?>
<!--
  grid.sumocfg — SUMO simulation configuration for the LifeLane mock grid.

  Usage:
    sumo -c sumo/network/grid.sumocfg
    sumo-gui -c sumo/network/grid.sumocfg

  The network file (grid.net.xml) is generated by netconvert:
    netconvert --node-files=grid.nod.xml --edge-files=grid.edg.xml \
               --tllogic-files=grid.tll.xml -o grid.net.xml

  *** SIMULATION ONLY — never connected to real traffic infrastructure ***
-->
<configuration>

    <input>
        <net-file     value="grid.net.xml"/>
        <route-files  value="grid.rou.xml"/>
        <additional-files value="grid.add.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end   value="3600"/>
        <step-length value="1.0"/>
    </time>

    <processing>
        <collision.action value="warn"/>
        <time-to-teleport value="300"/>
        <!-- Emergency vehicles may pass red signals (for realism) -->
        <ignore-route-errors value="true"/>
    </processing>

    <report>
        <verbose value="false"/>
        <no-step-log value="true"/>
        <duration-log.statistics value="true"/>
    </report>

    <traci_server>
        <remote-port value="8813"/>
    </traci_server>

</configuration>

