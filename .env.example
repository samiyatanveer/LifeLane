DATABASE_URL=sqlite+aiosqlite:///./lifelane.db
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
AUTH_SECRET=change-me-before-production
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TTL_MINUTES=15
# SMTP is optional locally. Without SMTP, reset links are written to the backend log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
EMAIL_DEV_LOG_LINKS=true
LOG_LEVEL=INFO
MODEL_DIR=models
# Public OSRM is enabled by default for local development. Use a managed or
# self-hosted OSRM URL for production traffic.
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_SECONDS=10
